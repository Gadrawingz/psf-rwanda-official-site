<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<%# @gadrawingz powered SEO %>
	<title><%- internals.title %> | PSF</title>
	<meta name="description" content="<%- internals.description %>">
	<!-- google font -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	<!-- plugins css -->
	<link rel="stylesheet" type="text/css" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/vendor/bootstrap/bootstrap.min.css">
	<link rel="stylesheet" type="text/css" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/vendor/reey-font/stylesheet.css">
	<link rel="stylesheet" type="text/css" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/vendor/font-awesome/css/all.min.css">
	<link rel="stylesheet" type="text/css" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/vendor/animate/animate.min.css">
	<link rel="stylesheet" type="text/css" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/vendor/flaticon/css/flaticon_towngov.css">
	<link rel="stylesheet" type="text/css" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/vendor/owl-carousel/owl.carousel.min.css">
	<link rel="stylesheet" type="text/css" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/vendor/swiper/swiper-bundle.min.css">
	<link rel="stylesheet" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/vendor/youtube-popup/youtube-popup.css">
	<link rel="stylesheet" type="text/css" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/css/custom.css">
	<link rel="stylesheet" type="text/css" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/css/style.css">
	<!-- favicons Icons -->
	<link rel="apple-touch-icon" sizes="180x180" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/images/favicon/apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/images/logo/cropped-psf-logo.png">
	<link rel="icon" type="image/png" sizes="16x16" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/images/logo/cropped-psf-logo.png">
	<link rel="manifest" href="<%= internals.has3RouteSegments ? '../../':'' %>clients/images/favicons/site.webmanifest">
</head>

<!-- Start Top banner -->
<div class="top-banner">
    <style>
        .top-banner {
            background: #000;
			background-size: 100% 100%;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 20px;
            position: relative;
			border-bottom: 0.5px solid #ffffff88;
        }
        .banner-left img {
            height: auto;
            max-height: 60px;
            width: auto;
            border: 1px solid #fff;
        }

        .banner-center {
            text-align: center;
        }
        
		.banner-countdown {
            font-size: 0.9em;
            margin-top: 5px;
            color: #f8c369da;
        }
        
		.banner-right {
            border: 3px solid #fff;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
			font-weight: bolder;
        }
        
		.close-banner {
            position: absolute;
            right: 5px;
            top: 5px;
            cursor: pointer;
            font-size: 20px;
        }
    </style>

    <div class="banner-left">
        <img src="clients/images/logo/kwibuka-psf.png" alt="PSF Logo">
    </div>
	<a href="https://kwibuka.rw/" style="color: #FFFFFF;" target="_blank">
		<div class="banner-center">
			<div class="banner-text">Remember - Unite - Renew</div>
			<div class="banner-countdown" id="countdown"></div>
		</div>
	</a>
    <div class="banner-right">31</div>
    <span class="close-banner">&times;</span>

    <script>
        function updateCountdown() {
            const startDate = new Date('2025-04-07');
            const today = new Date();
            const elapsed = Math.floor((today - startDate) / (1000 * 60 * 60 * 24));
            const remaining = Math.max(0, 100 - elapsed);
            document.getElementById('countdown').textContent = `The ${elapsed}th day of the 100-day #Kwibuka31 commemoration.`;
        }
        
        document.querySelector('.close-banner').addEventListener('click', function() {
            document.querySelector('.top-banner').style.display = 'none';
        });

        updateCountdown();
        setInterval(updateCountdown, 86400000);
    </script>
</div>
<!-- End Top banner -->