<script>

// Summernote
$(document).ready(function () {
    $('.summernote').summernote({
        placeholder: "Start writing an article...",
        tabsize: 2,
        height: 140,
        focus: true,
        toolbar: [
            ['style', ['style']]
            ['font', ['bold', 'underline', 'clear']],
            ['para', ['ul', 'ol']],
            ['color', ['color']],
            ['table', ['table']],
            ['insert', ['link', 'picture', 'video']],
            ['view', ['fullscreen', 'codeview', 'help']],
        ]
    });
});
</script>

