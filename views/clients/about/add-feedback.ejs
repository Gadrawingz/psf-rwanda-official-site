<!-- Feedback section-->
<section class="contact-section pt-6">
    <div class="container">
        <div class="row">
            <div class="section-title-box text-center">
                <div class="section-tagline">Have a feedback? We'd love to hear from you</div><hr><br>
            </div>

            <div class="col-lg-12">
                <% if (message.length!=0) { %>
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle alert-icon"></i>
                    <%- message %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>

                <form action="/post-feedback" class="contact-form" method="POST">
                    <div class="row row-gutter-10">

                        <div class="col-12 col-lg-12">
                            <label for="visitor">Visitor&nbsp;</label><input type="radio" name="is_member" id="visitor" value="Visitor" checked>&nbsp;&nbsp;&nbsp;&nbsp;
                            <label for="member">PSF Member&nbsp;</label><input type="radio" name="is_member" id="member" value="Member">&nbsp;&nbsp;&nbsp;&nbsp;
                            <label for="tourist">Tourist&nbsp;</label><input type="radio" name="is_member" id="tourist" value="Tourist"><hr>
                        </div>

                        <div class="col-12 col-lg-4">
                            <label class="cst-form-label" for="subject">Feedback subject</label>&nbsp;<span class="cst-red">*</span>
                            <select id="subject" class="input-text" name="subject">
                                <option value="<%= subject %>"><%= subject %></option>
                                <option value="Exhibition">Exhibition</option>
                                <option value="Membership">Membership</option>
                                <option value="Advocacy">Advocacy</option>
                                <option value="Quitus">Quitus Recommendation</option>
                                <option value="IBI">IBI</option>
                                <option value="BRC">BRC</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="col-12 col-lg-4">
                            <label class="cst-form-label" for="company">Your company (Optional)</label>
                            <input type="text" id="company" class="input-text" name="company" value="<%= company %>">
                        </div>

                        <div class="col-12 col-lg-4">
                            <label class="cst-form-label" for="rating">Rating </label>&nbsp;<span class="cst-red">*</span>
                            <select id="rating" class="input-text" name="rating">
                                <option value="<%= rating %>"><%= rating %></option>
                                <option value="5">5/5 (Excellent)</option>
                                <option value="4">4/5 (Great)</option>
                                <option value="3">3/5 (Good)</option>
                                <option value="2">2/5 (OK)</option>
                                <option value="1">1/5 (Poor)</option>
                            </select>
                        </div>

                        <div class="col-12 col-lg-4">
                            <label class="cst-form-label" for="names">Names </label>&nbsp;<span class="cst-red">*</span>
                            <input type="text" id="names" class="input-text" name="names" value="<%= names %>">
                        </div>
                        
                        <div class="col-12 col-lg-4">
                            <label class="cst-form-label" for="email">Email Address</label>&nbsp;<span class="cst-red">*</span>
                            <input type="email" id="email" class="input-text" name="email" value="<%= email %>">
                        </div>

                        <div class="col-12 col-lg-4">
                            <label class="cst-form-label" for="phone">Phone Number(Optional)</label>
                            <input type="number" id="phone" class="input-text" name="telephone" value="<%= telephone %>">
                        </div>

                        <div class="col-12 col-lg-12">
                            <label class="cst-form-label" for="message">Your Feedback:</label>
                            <textarea name="message" id="message" placeholder="Write a message" class="input-text"><%= message %></textarea>
                        </div>
                        
                        <div class="col-12 col-lg-12 text-center">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>