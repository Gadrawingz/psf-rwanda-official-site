<!--page-banner-->
<section class="page-banner">
    <div class="container">
        <div class="page-breadcrumbs">
            <ul class="list-unstyled">
                <li><a href="/home">Home</a></li>
                <li>Team</li>
            </ul>
        </div>
        <div class="page-banner-title">
            <h3>PSF Management</h3>
        </div>
    </div>
</section>

<!--team-section-->
<section class="team-section">
    <div class="container">
        
        <div class="section-title-box text-center">
            <div class="section-tagline">Senior Management</div>
        </div><hr>
        <!-- Senior Management -->
        <!-- Block 1 -->
        <div class="row row-gutter-y-30" style="display: flex; justify-content: center;">
            
            <div class="col-12 col-md-6 col-xl-4">
                <div class="team-card cst-orange-border-sm">
                    <div class="team-card-img">
                        <img src="clients/images/team/team-cao-callixte.png" class="img-fluid" alt="img-78">
                        <div class="team-card-icon">
                            <a href="mailto:stephenr@psf.org.rw" class="twitter"><i class="fa-brands fa-twitter"></i></a>
                        </div>
                    </div>
                    <div class="team-card-content">
                        <h4><a href="#">Callixte KANAMUGIRE</a></h4>
                            <p title="Chief Administrative Officer">Chief Administrative Officer(C.A.O)</p>
                            <p class="team-mail-blue">callixtek@psf.org.rw</p>
                    </div>
                </div>            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <div class="team-card cst-orange-border-sm">
                    <div class="team-card-img">
                        <img src="clients/images/team/team-coo-faustin.jpg" class="img-fluid" alt="img-80">
                        <div class="team-card-icon">
                            <a href="#" class="twitter"><i class="fa-brands fa-twitter"></i></a>
                        </div>
                    </div>
                    <div class="team-card-content">
                        <h4><a href="#">Faustin KARASIRA</a></h4>
                        <p title="Chief Operating Officer">Chief Operating Officer (C.O.O)</p>
                        <p class="team-mail-blue">faustink@psf.org.rw</p>
                    </div>
                </div>
            </div>
        </div><br>
        
        <!-- Block 2 -->
        <div class="row row-gutter-y-30" style="display: flex; justify-content: center;">
            
            <div class="col-12 col-md-6 col-xl-4">
                <div class="team-card cst-orange-border-sm">
                    <div class="team-card-img">
                        <img src="clients/images/team/team-felix-mutagoma.jpg" class="img-fluid" alt="img-78">
                        <div class="team-card-icon">
                            <a href="mailto:felixm@psf.org.rw" class="twitter"><i class="fa-brands fa-twitter"></i></a>
                        </div>
                    </div>
                    <div class="team-card-content">
                        <h4><a href="#">Felix MUTAGOMA</a></h4>
                        <p title="Director of Human Resources">Director of Human Resources</p>
                        <p class="team-mail-blue">felixm@psf.org.rw</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <div class="team-card cst-orange-border-sm">
                    <div class="team-card-img">
                        <img src="clients/images/team/team-james-ngabo.jpg" class="img-fluid" alt="img-78">
                        <div class="team-card-icon">
                            <a href="mailto:jamesn@psf.org.rw" class="twitter"><i class="fa-brands fa-twitter"></i></a>
                        </div>
                    </div>
                    <div class="team-card-content">
                        <h4><a href="#">James NGABO</a></h4>
                        <p title="Acting Director of Finance">Acting Director of Finance</p>
                        <p class="team-mail-blue">jamesn@psf.org.rw</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <div class="team-card cst-orange-border-sm">
                    <div class="team-card-img">
                        <img src="clients/images/team/team-walter-hunde.jpg" class="img-fluid" alt="img-80">
                        <div class="team-card-icon">
                            <a href="#" class="twitter"><i class="fa-brands fa-twitter"></i></a>
                        </div>
                    </div>
                    <div class="team-card-content">
                        <h4><a href="#">Hunde Walter</a></h4>
                        <p title="Director of Internal Audit">Director of Internal Audit</p>
                        <p class="team-mail-blue">walterh@psf.org.rw</p>
                    </div>
                </div>
            </div>
        </div><br>

        <!-- Block 3 -->
        <div class="row row-gutter-y-30" style="display: flex; justify-content: center;">
            <div class="col-12 col-md-6 col-xl-4">
                <div class="team-card cst-orange-border-sm">
                    <div class="team-card-img">
                        <img src="clients/images/team/team-ephrem-karangwa.jpg" class="img-fluid" alt="img-78">
                        <div class="team-card-icon">
                            <a href="mailto:ephremk@psf.org.rw" class="twitter"><i class="fa-brands fa-twitter"></i></a>
                        </div>
                    </div>
                    <div class="team-card-content">
                        <h4><a href="#">KARANGWA Ephrem</a></h4>
                        <p title="Director of Operations">Director of Operations</p>
                        <p class="team-mail-blue">ephremk@psf.org.rw</p>
                    </div>
                </div>
            </div><br>

            <div class="col-12 col-md-6 col-xl-4">
                <div class="team-card cst-orange-border-sm">
                    <div class="team-card-img">
                        <img src="clients/images/team/team-joseph-mutabazi.jpg" class="img-fluid" alt="img-80">
                        <div class="team-card-icon">
                            <a href="mailto:josephm@psf.org.rw" class="twitter"><i class="fa-brands fa-twitter"></i></a>
                        </div>
                    </div>
                    <div class="team-card-content">
                        <h4><a href="#">MUTABAZI Joseph</a></h4>
                        <p title="Director of Trade and Business Development">Director of Trade and Business Development</p>
                        <p class="team-mail-blue">josephm@psf.org.rw</p>
                    </div>
                </div>
            </div>
        </div><hr><br><hr><br>

        <div class="section-title-box text-center">
            <div class="section-tagline">PSF Staff Members</div>
        </div><hr>
                
        <% if(internals.dataMainOp.length > 0) { %>
            <div class="row row-gutter-y-30" style="display: flex; justify-content: center;"> 
                <% for(let g=0; g < internals.dataMainOp.length; g++ ) { %>
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="team-card cst-orange-border-sm">
                        <div class="team-card-img">
                            <% if(internals.dataMainOp[g].profile_pic > 0 ) { %> 
                            <img src="clients/images/team/<%= internals.dataMainOp[g].profile_pic; %>" class="img-fluid" alt="img-78">
                            <% } else if(internals.dataMainOp[g].gender=='Female') { %>
                            <img src="clients/images/team/profile-female.png" class="img-fluid" alt="img-78">
                            <% } else { %>
                            <img src="clients/images/team/profile-male.jpg" class="img-fluid" alt="img-78">
                            <% } %>
    
                            <div class="team-card-icon">
                                <a href="mailto:<%= internals.dataMainOp[g].email; %>" class="twitter"><i class="fa-brands fa-microsoft"></i></a>
                            </div>
                        </div>
                        <div class="team-card-content">
                            <h4><a href="#"><%= internals.dataMainOp[g].firstname; %> <%= internals.dataMainOp[g].lastname; %></a></h4>
                            <p title="<%= internals.dataMainOp[g].position; %>"><%= internals.dataMainOp[g].position; %></p>
                            <p class="team-mail-blue"><%= internals.dataMainOp[g].email; %></p>
                        </div>
                    </div>
                </div><br>
                <% } %>
            </div>
        <% } else { } %><br>

    </div>
</section>