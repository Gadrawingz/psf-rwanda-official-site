<!--page-banner-->
<section class="page-banner">
    <div class="container">
        <div class="page-breadcrumbs">
            <ul class="list-unstyled">
                <li><a href="/">Home</a></li>
                <li>Clusters</li>
            </ul>
        </div>
        <div class="page-banner-title">
            <h3><%= internals.title %></h3>
        </div>
    </div>
</section>

<section class="event-details-section pt-5">
    <div class="container">
        <div class="row">
            <div class="section-title-box text-center">
                <div class="section-tagline">ALL ASSOCIATIONS IN THIS CLUSTER</div>
                <div class="cst-sh-description">
                    <%= internals.description %>
                </div><br>
            </div><hr>
            <!-- ROWS BLOCK -->
            <div class="col-lg-12">
                <table class="cst-outable">
                    <thead>
                        <tr>
                            <th>N<sup>o</sup></th>
                            <th>Association Name</th>
                            <th>Cluster</th>
                            <th>Leader Name / Position</th>
                            <th>Company Name</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    
                    <% if(data.length > 0) { %>
                    <tbody>
                        <% data.forEach(row => { %>
                        <tr>
                            <td>#</td>
                            <td><%= row.assoc_name %></td>
                            <td><%= row.cluster_name; %></td>
                            <td>
                                <%= row.leader_name; %><br>
                                <%= row.leader_position; %>
                            </td>
                            <td><%= row.company; %></td>
                            <td><%= row.email; %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                    <% } else { %>
                    <tfoot>
                        <tr>
                            <td colspan="6" class="text-center">No Data Found At The Moment!</td>
                        </tr>
                    </tfoot>
                    <% } %>
                    </tr>
                </table>
            </div><hr><br>

        </div>
    </div>
</section>