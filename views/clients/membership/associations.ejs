<!--page-banner-->
<section class="page-banner">
    <div class="container">
        <div class="page-breadcrumbs">
            <ul class="list-unstyled">
                <li><a href="/">Home</a></li>
                <li>Associations</li>
            </ul>
        </div>
        <div class="page-banner-title">
            <h3><%= internals.title %> </h3>
        </div>
    </div>
</section>

<section class="event-details-section pt-5">
    <div class="container">
        <div class="row">
            <div class="section-title-box text-center">
                <di class="section-tagline">ASSOCIATIONS IN &OpenCurlyDoubleQuote;AGRICULTURE&CloseCurlyDoubleQuote; CLUSTER</di
                    v>
            </div><hr>
            <!--BLOCK 1 -->
            <div class="col-lg-12">
                <table class="cst-outable">
                    <thead>
                        <tr>
                            <th>N<sup>o</sup></th>
                            <th>Association Name</th>
                            <th>Cruster</th>
                            <th>Leader Name (Position)</th>
                            <th>Company Name</th>
                        </tr>
                    </thead>
                    
                    <% if(data.tableAgro.length > 0) { %>
                    <tbody>
                        <% data.tableAgro.forEach(row => { %>
                        <tr>
                            <td>#</td>
                            <td><%= row.association %></td>
                            <td><%= row.cluster_name; %></td>
                            <td>
                                <%= row.leader_name; %><br>
                                <%= row.leader_position; %>
                            </td>
                            <td><%= row.company; %></td>
                        </tr>
                        <% }) %>
                        <tr>
                            <td colspan="6" class="outable-bluely">
                                <a href="/view/cluster/agriculture" class="text-center">View more associations </a>
                            </td>
                        </tr>
                    </tbody>
                    <% } else { %>
                    <tfoot>
                        <tr>
                            <td colspan="6" class="text-center">No Data Found At The Moment!</td>
                        </tr>
                    </tfoot>
                    <% } %>
                    </tr>
                </table>
            </div><br><br>


