<!--page-banner-->
<section class="page-banner">
    <div class="container">
        <div class="page-breadcrumbs">
            <ul class="list-unstyled">
                <li><a href="/home">Home</a></li>
                <li>Gallery</li>
            </ul>
        </div>
        <div class="page-banner-title">
            <h3>PSF Gallery</h3>
        </div>
    </div>
</section>

<!-- Gallery section -->
<div class="portfolio-section pt-6">
    <div class="section-title-box text-center">
        <div class="section-tagline"><%- internals.title %> </div>
    </div><hr>

    <div class="container">
        <% if(internals.data.length > 0) { %>
        <div class="row row-gutter-30">
            <%# Loop of gallery records %>
            <% for(let g=0; g < internals.data.length; g++ ) { %>
            <div class="col-lg-4 col-md-4">
                <div class="portfolio-card" title="<%= internals.moment(internals.data[g].created_at).format('DD-MM-YYYY'); %>">
                    <img src="../uploads/gallery/<%= internals.data[g].file_name %>" class="img-fluid" alt="img-97" />
                    <div class="portfolio-card-meta">
                        <div class="portfolio-card-text"><a href="#"><%= internals.data[g].img_title %></a></div>
                        <div class="portfolio-card-title"><a href="#"><%= internals.data[g].img_description %></a></div>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
        <% } else { } %>

        <div class="row">
            <div class="col-lg-12">
                <div class="blog-pagination-outer">
                    <div class="blog-pagination">
                        <a class="prev page-numbers" href="#">
                            <b><i class="fa-solid fa-chevron-left"></i></b>
                        </a>
                        <span class="page-numbers current"><b>01</b></span>
                        <a class="page-numbers" href="#"><b>02</b></a>
                        <a class="page-numbers" href="#"><b>03</b></a>
                        <a class="page-numbers" href="#"><b>04</b></a>
                        <a class="next page-numbers" href="#">
                            <b><i class="fa-solid fa-chevron-right"></i></b>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
