<!--page-banner-->
<section class="page-banner">
    <div class="container">
        <div class="page-breadcrumbs">
            <ul class="list-unstyled">
                <li><a href="/home">Home</a></li>
                <li>Documents </li>
            </ul>
        </div>
        <div class="page-banner-title">
            <h3><%- internals.title %></h3>
        </div>
    </div>			
</section>

<section class="document-section pt-3">
    <div class="container">
        <!--<hr>-->
        <div class="row">
            <div class="col-lg-12">
                <div class="donate-box-inner text-center">
                    <h4 style="border-bottom: 2px solid #075c123d; padding: 10px; margin: 15px!important" class="text-center">View Document by month (2024)</h4>
                    <ul class="documents-link">
                        <% data.table24.forEach(item => { %> 
                        <li>
                            <a href="/view/docs/<%= item.dt_id %>">
                                <span class="link-block"><%= item.dt_month %></span>
                            </a>
                        </li>
                        <% }) %>
                    </ul>
                </div>
                <hr>
                <div class="donate-box-inner text-center">
                    <h4 style="border-bottom: 2px solid #075c123d; padding: 10px; margin: 15px!important" class="text-center">View Document by month (2025)</h4>
                    <ul class="documents-link">
                        <% data.table25.forEach(item => { %> 
                        <li>
                            <a href="/view/docs/<%= item.dt_id %>">
                                <span class="link-block"><%= item.dt_month %></span>
                            </a>
                        </li>
                        <% }) %>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>


