<!--page-banner-->
<section class="page-banner">
    <div class="container">
        <div class="page-breadcrumbs">
            <ul class="list-unstyled">
                <li><a href="/home">Home</a></li>
                <li>Documents </li>
            </ul>
        </div>
        <div class="page-banner-title">
            <h3><%- internals.title %></h3>
        </div>
    </div>			
</section>

<section class="document-section pt-3">
    <div class="container">
        <!--<hr>-->
        <div class="row">
            <div class="col-lg-12">
                <div class="donate-box-inner text-center">
                    <h4 class="table8-header">Current documents by year</h4>
                    <div class="table8-block">
                        <div class="table8">
                            <div class="table8-row header"> 
                                <div class="table8-cell"> 2024 </div>
                            </div>
    
                            <% data.table24.forEach(item => { %> 
                            <div class="table8-row">
                                <div class="table8-cell">
                                    <a href="/view/docs/<%= item.dt_id %>">
                                        <%= item.dt_month %>
                                    </a>
                                </div>
                            </div>
                            <% }) %>
                        </div>
    
                        <div class="table8">
                            <div class="table8-row header"> 
                                <div class="table8-cell"> 2025 </div>
                            </div>
    
                            <% data.table25.forEach(item => { %> 
                            <div class="table8-row">
                                <div class="table8-cell">
                                    <a href="/view/docs/<%= item.dt_id %>">
                                        <%= item.dt_month %>
                                    </a>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>


