<!--page-banner-->

<section class="page-banner">
    <div class="container">
        <div class="page-breadcrumbs">
            <ul class="list-unstyled">
                <li><a href="/home">Home</a></li>
                <li>Posts </li>
            </ul>
        </div>
        <div class="page-banner-title">
            <h3>PSF POST article</h3>
        </div>
    </div>
</section>

<section class="news-details-section pt-4">
    <div class="container pt-0">
        <div class="row">
            <!-- real post -->
            <% if(internals.data.length != 0) { %>
            <div class="col-lg-8">
                <div class="news-details-box-image">
                    <div class="news-details-box-image-inner">
                    <img src="../../uploads/posts/<%= internals.data[0].post_image %>" class="img-fluid" alt="img-193">
                        <a href="#" class="news-details-box-date"><%= internals.data[0].post_category %></a>
                    </div>
                </div>
                <div class="news-details-meta-box">
                    <div class="news-details-meta-box-inner">
                        <span class="author">
                            Posted by<a href="#"><%= internals.data[0].author_fn %> <%= internals.data[0].author_ln %></a>
                        </span>
                        <span class="published-date">On: <%= internals.data[0].post_date.toLocaleDateString() %></span>
                    </div>
                </div><hr>
                <div class="news-details-content-box">
                    <h2><%= internals.data[0].post_title %></h2>
                    <div style="line-height: 30px!important; color: black;">
                        <%- internals.data[0].post_text %>
                    </div>
                </div>
                <div class="news-details-share-box">
                    <div class="news-details-inner">
                        <div class="news-details-list">
                            <div class="news-details-list-title">
                                <h4>Categorized in:</h4>
                            </div>
                            <div class="news-details-list-button">
                                <a href="#" class="btn btn-primary"><%= internals.data[0].post_category %></a>
                            </div>
                        </div>
                        <div class="news-details-list">
                            <div class="news-details-socials">
                                <a target="_blank" href="https://twitter.com/intent/tweet?text=<%= internals.data[0].post_title %>&url=https://psf.org.rw/view/post/<%= internals.data[0].post_slug %>"><i class="fa-brands fa-twitter"></i></a>
                                <a target="_blank" href="https://www.facebook.com/sharer/sharer.php?u=https://psf.org.rw/view/post/<%= internals.data[0].post_slug %>"><i class="fa-brands fa-facebook"></i></a>
                                <a target="_blank" href="https://pinterest.com/pin/create/button/?url=https://psf.org.rw/view/post/<%= internals.data[0].post_slug %>"><i class="fa-brands fa-pinterest-p"></i></a>
                                <a target="_blank" href="https://www.linkedin.com/sharing/share-offsite/?url=https://psf.org.rw/view/post/<%= internals.data[0].post_slug %>"><i class="fa-brands fa-linkedin"></i></a>
                                <a target="_blank" href="https://web.whatsapp.com/send?text=https://psf.org.rw/view/post/<%= internals.data[0].post_slug %>" data-original-title="whatsapp" rel="tooltip" data-placement="left" data-action="share/whatsapp/share"><i class="fa-brands fa-whatsapp"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- post sidebar -->
            <div class="col-lg-4">
                <div class="sidebar">
                    <div class="sidebar-widget sidebar-widget-recent-post">
                        <% if(internals.asideData.length > 0) { %>
                        <h4 title="Blog">Related Press Releases</h4>
                        <% for (let g = 0; g < internals.asideData.length; g++) { %>
                        <div class="sidebar-recent-post">
                            <div class="sidebar-recent-post-img">
                                <img src="../../clients/images/blog/blog-details-2.jpg" alt="<%= internals.asideData[g].post_title %>">
                            </div>
                            <div class="sidebar-recent-post-content">
                                <div class="sidebar-meta">
                                    <div class="sidebar-meta-item">
                                        <div class="sidebar-meta-icon">
                                            <span class="author">
                                                <a href="#">(<%= internals.asideData[g].post_category %>)</a>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="sidebar-post-title">
                                        <h5><a href="/view/post/<%= internals.asideData[g].post_slug %>"><%= internals.asideData[g].post_title %></a></h5>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }} else { %>
                        <% }%>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>