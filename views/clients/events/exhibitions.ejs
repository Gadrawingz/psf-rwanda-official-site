<!--page-banner-->
<section class="page-banner">
    <div class="container">
        <div class="page-breadcrumbs">
            <ul class="list-unstyled">
                <li><a href="/home">Home</a></li>
                <li>Events</li>
            </ul>
        </div>
        <div class="page-banner-title">
            <h3>PSF Exhibitions</h3>
        </div>
    </div>			
</section>


<!--event-three-section-->
<section class="event-three-section">
    <div class="event-section-outer">
        <div class="container">
            <% if(internals.data.length > 0) { %>
            <div class="row row-gutter-y-30">
                
                <% for(let g=0; g < internals.data.length; g++ ) { %>
                <div class="col-12 col-lg-6 col-xl-6">
                    <div class="event-card">
                        <div class="event-card-image">
                            <div class="event-card-image-inner">
                                <a href="#"><img src="../uploads/events/<%= internals.data[g].event_image %>" class="img-fluid" alt="img-90" style="height: 40px!important; width: 40px!important;"></a>		
                                <div class="event-card-meta">
                                    <div class="event-meta-number">
                                        <span><%= internals.moment(internals.data[g].created_at).format('DD'); %></span>
                                    </div>
                                    <div class="event-meta-date">
                                        <span><%= internals.moment(internals.data[g].created_at).format('MM-YYYY'); %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="event-card-content">
                            <div class="event-card-info">
                                <ul class="list-unstyled">
                                    <li>
                                        <i class="fa-solid fa-clock"></i>
                                        <span><%= internals.data[g].start_date %> - <%= internals.data[g].end_date %></span>
                                    </li>
                                    <li>
                                        <i class="fa-sharp fa-solid fa-location-pin"></i>
                                        <span>Huye, Tumba</span>
                                    </li>
                                </ul>
                            </div>
                            <div class="event-card-title">
                                <h4><a href="#">Mini Expo Rwanda</a></h4>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>

            </div>
            <% } else { } %>
        </div>
    </div>
</section>
