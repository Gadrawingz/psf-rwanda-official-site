<!--page-banner-->
<section class="page-banner">
    <div class="container">
        <div class="page-breadcrumbs">
            <ul class="list-unstyled">
                <li><a href="/home">Home</a></li>
                <li>Events</li>
            </ul>
        </div>
        <div class="page-banner-title">
            <h3>PSF Exhibitions</h3>
        </div>
    </div>			
</section>

<!--event-three-section-->
<section class="event-three-section">
    <div class="event-section-outer pt-5">
        <div class="container">
            <div class="section-title-box">
                <div class="section-tagline">WHY EXHIBITION?</div>
            </div><hr>
            <div class="row">
                <div class="col-lg-12">
                    <div class="event-details-content-box">
                        <p>Exhibition is a platform for businesses, investors, and development partners to showcase their products, services, and innovative solutions for economic development in Africa. The exhibition focuses on key sectors such as agriculture, manufacturing, services, and governance, in line with the theme of <strong>Creating African Wealth under the AfCFTA.</strong>. Participants at the exhibition have the opportunity to connect with industry leaders, policy makers, and potential partners, while also gaining valuable insights into the latest trends and opportunities in Africa’s economy.</p>
                    </div><br>
                    
                </div>
            </div>
            <div class="section-title-box">
                <div class="section-tagline">ALL EXHIBITION EVENTS</div>
            </div><hr><br>

            <% if(internals.data.length > 0) { %>
            <div class="row row-gutter-y-30">
                
                <% for(let g=0; g < internals.data.length; g++ ) { %>
                <div class="col-12 col-lg-6 col-xl-6">
                    <div class="event-card">
                        <div class="event-card-image">
                            <div class="event-card-image-inner">
                                <a href="#"><img src="clients/images/event/event-2.jpg" class="img-fluid" alt="img-164"></a>		
                                <div class="event-card-meta">
                                    <div class="event-meta-number">
                                        <span><u><%= internals.moment(internals.data[g].start_date).format('Do'); %></u></span>
                                    </div>
                                    <div class="event-meta-date">
                                        <span><%= internals.moment(internals.data[g].start_date).format('MMMM YYYY'); %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="event-card-content">
                            <div class="event-card-info">
                                <ul class="list-unstyled">
                                    <li>
                                        <i class="fa-solid fa-clock"></i>
                                        <span>
                                            <b><%= internals.moment(internals.data[g].start_date).format('DD MMM. YYYY'); %> - 
                                            <%= internals.moment(internals.data[g].end_date).format('DD MMM. YYYY'); %></b>
                                        </span>
                                    </li>
                                    <li>
                                        <i class="fa-sharp fa-solid fa-location-pin"></i>
                                        <span><%= internals.data[g].event_venue; %></span>
                                    </li>
                                </ul>
                            </div>
                            <div class="event-card-title">
                                <h4><a href="#"><%= internals.data[g].event_name; %></a></h4>
                            </div><hr>
                            <div class="event-card-info">
                                <ul class="list-unstyled">
                                    <li>
                                        <i class="fa-sharp fa-solid fa-phone"></i>
                                        <span class="text-dark" title="Call: <%= internals.data[g].contact_phone; %>"><b><%= internals.data[g].contact_email; %></b></span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>

            </div>
            <% } else { } %>
        </div>
    </div>
</section>
