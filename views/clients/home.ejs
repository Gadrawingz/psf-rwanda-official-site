<!-- blog-section with latest 3 releases -->
<section class="blog-section blog-section-two">
    <div class="blog-box">
        <div class="section-title-box text-center">
            <div class="section-tagline">PSF MEDIA</div>
            <h2 class="section-title">Our Latest press releases</h2>
        </div>
    </div>
    <div class="container">
        <!--If post found here -->
        <% if(internals.data.length > 0) { %>
        <div class="row row-gutter-y-155">
            <% for (let g = 0; g < internals.data.length; g++) { %>
            <div class="col-lg-6 col-xl-4">
                <div class="blog-card">
                    <div class="blog-card-image">
                        <img src="clients/images/blog/blog-1.jpg" class="img-fluid" alt="img-184">
                        <a href="/view/post/<%= internals.data[g].post_slug %>"></a>
                    </div>
                    <div class="blog-card-date">
                        <a href="#" title="<%= internals.moment(internals.data[g].post_date).format('DD-MM-YYYY'); %>"><%= internals.moment(internals.data[g].post_date).startOf('day').fromNow(); %></a>
                    </div>
                    <div class="blog-card-content">
                        <div class="blog-card-meta">
                            <span class="tagged">
                                <a href="#"><%= internals.data[g].post_category %></a>
                            </span>
                        </div>
                        <h4><a href="/view/post/<%= internals.data[g].post_slug %>"><%= internals.data[g].post_title %></a></h4>
                        <p><a href="/view/post/<%= internals.data[g].post_slug %>" class="text-success cst-read-more-link">...Read full article...</a></p>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
        <% } else { } %>
    </div>
</section>