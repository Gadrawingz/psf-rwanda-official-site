<div class="content-wrapper">

    <!-- Row start -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <h3><%- internals.title %></h3>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Row start -->
                    <form action="/documents/insert" method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-xxl-8 col-xl-7 col-lg-7 col-md-6 col-sm-12 col-12">
                                <% if(message.length!=0) { %>
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="bi bi-x-circle alert-icon"></i>
                                    <%- message %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                                <% } %>
                                
                                <div class="row">
                                    <div class="col-xxl-6 col-sm-6 col-12">
                                        <div class="mb-3">
                                            <label for="year_month" class="form-label"><strong>Select Year/Month</strong></label>
                                            <select class="form-control" id="year_month" name="year_month">
                                                <option value="">Select Year/Month</option>
                                                <% for(let g=0; g < internals.yearsData.length; g++ ) { %>
                                                <option value="<%= internals.yearsData[g].dt_id %>">
                                                    <u><%= internals.yearsData[g].dt_year %></u> - <%= internals.yearsData[g].dt_month_no %>(<%= internals.yearsData[g].dt_month %>)
                                                </option>
                                                <% } %>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-xxl-6 col-sm-6 col-12">
                                        <div class="mb-3">
                                            <label for="doc_title" class="form-label"><strong>Document Title</strong></label>
                                            <input type="text" class="form-control" id="doc_title" name="doc_title" value="<%= doc_title %>">
                                        </div>
                                    </div>

                                    <div class="col-xxl-12 col-sm-12 col-12">
                                        <div class="mb-3">
                                            <label for="attachment" class="form-label"><strong>Document File(Attachment)</strong></label>
                                            <input type="file" class="form-control" id="attachment" name="attachment">
                                        </div>
                                    </div>

                                    <div class="col-xxl-12 col-sm-12 col-12">
                                        <div class="mb-3">
                                            <label for="description" class="form-label"><strong>Add Description</strong></label>
                                            <textarea class="form-control" id="description" name="description" rows="4"><%= description %></textarea>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-sm-12 col-12">
                                <button class="btn btn-info" type="submit">Save</button>
                                <button class="btn btn-danger" type="reset">Cancel</button>
                            </div>
                        </div>
                    </form><!-- Row end -->
                </div>
            </div><!-- Card end -->
        </div>
    </div>
    <!-- Row end -->
</div>