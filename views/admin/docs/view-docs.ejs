<!-- Row start -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="card-title"><h3><%- internals.title %></h3></div>
            </div>
            <div class="card-body">
                <div class="custom-btn-group mb-2">
                    <a href="/documents/add" class="btn btn-info"><i class="bi bi-plus-square"></i> Add new</a>
                </div>
                <div class="table-responsive">
                    <% if (message.length!=0) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-x-circle alert-icon"></i>
                        <%- message %> 
                        <button type="button" class="btn-close" data-bs-dismiss="alert"
                                aria-label="Close"></button>
                    </div>
                    <% } if (internals.data.length != 0) { %>
                    <table class="table table-bordered m-0">
                        <thead>
                            <tr>
                                <th>NO</th>
                                <th>Document Title</th>
                                <th>Description</th>
                                <th>Uploaded by</th>
                                <th>Attachment</th>
                                <th>Status</th>
                                <th class="text-center">The Date</th>
                                <th colspan="2" class="text-center">Action</th>	
                            </tr>
                        </thead>

                        <tbody>
                            <% for(let g = 0; g < internals.data.length; g++) { %> 
                            <tr>
                                <td><i class="bi bi-check2-circle"></i><%= (g+1) %></td>
                                <td><%= internals.data[g].doc_title %></td>
                                <td><%= internals.data[g].description %></td>
                                <td><%= internals.data[g].firstname %> <%= internals.data[g].lastname %></td>
                                <td class="text-center">
                                    <a href="../uploads/docs/<%= internals.data[g].attachment %>" target="_blank">
                                        <img src="../admin/images/thumbnail/pdf-thumbnail-lg.jpg" style="height: 30px; width: auto;"/>
                                    </a>                                
                                </td>
                                <td class="text-center"><%= internals.data[g].status %></td>
                                <td class="text-center"><%= internals.moment(internals.data[g].upload_date).format("DD.MM.YYYY") %></td>

                                <td class="text-center">
                                    <a href="/documents/edit/<%= internals.data[g].doc_id %>" class="btn btn-primary"  title="Edit this row"><i class="bi bi-pencil-square"></i></a>
                                </td>
                                <td class="text-center">
                                    <a href="/documents/delete/<%= internals.data[g].doc_id %>" class="btn btn-danger" onclick="return confirm('Do you want to delete this row?')"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                    <% } else { %>
                    <div class="alert alert-primary alert-dismissible fade show" role="alert">
                        <i class="bi bi-bullseye alert-icon"></i>No data found!
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

    </div>
</div>
<!-- Row end -->
