<!-- Row start -->
<div class="row">
    <div class="col-sm-12 col-12">
        <div class="card">
            <div class="card-header">
                <div class="card-title"><%- internals.title %> </div>
            </div>
            <div class="card-body">
                <!-- Row start -->
                <% if (message.length!=0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle alert-icon"></i>
                    <%- message %> 
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>
                <form action="/gallery/update/<%= internals.gallery_id %>" method="post">
                    <div class="row">
                        <div class="col-xl-6 col-sm-6 col-12 mt-3 mb-3">
                            <div class="was-validated">
                                <label for="img_title" class="form-label"><strong>The title</strong></label>
                                <input type="text" class="form-control" id="img_title" name="img_title" value="<%- internals.img_title %>"/>
                                <div class="invalid-feedback">Please add meaningful title.</div>
                            </div>
                        </div> 

                        <div class="col-xl-6 col-sm-6 col-12 mt-3 mb-3">
                            <div class="was-validated">
                                <label for="img_description" class="form-label"><strong>Description</strong></label>
                                <input type="text" class="form-control" id="img_description" name="img_description" value="<%- internals.img_description %>"/>
                                <div class="invalid-feedback">Please describe the file in short.</div>
                            </div>
                        </div>

                        <div class="custom-btn-group flex-start">
                            <button class="btn btn-success" type="submit">Save Changes</button>
                            <button class="btn btn-dark" type="reset">Clear</button>
                        </div>
                    </div>
                </form>
                <!-- Row end -->
            </div>
        </div>
    </div>
</div>
<!-- Row end -->