<!-- Row start -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="card-title"><h3><%- internals.title %></h3></div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <% if (message.length!=0) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-x-circle alert-icon"></i>
                        <%- message %> 
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                    <% } if (internals.data.length != 0) { %>
                    <table class="table table-bordered m-0">
                        <thead>
                            <tr>
                                <th>N<sup>o</sup></th>
                                <th>Names/Phone</th>
                                <th>Email Address</th>
                                <th>Subject</th>
                                <th>Status</th>
                                <th>Message</th>
                                <th class="text-center">Date</th>
                                <th class="text-center">Published</th>
                                <th class="text-center">#</th>
                            </tr>
                        </thead>
                         	
                        <tbody>
                            <% for(let g = 0; g < internals.data.length; g++) { %> 
                            <tr>
                                <td><i class="bi bi-check2-circle"></i><%= (g+1) %></td>
                                <td>
                                    <%= internals.data[g].names %><br>
                                    <b>(<%= internals.data[g].telephone %>)</b>
                                </td>
                                <td>
                                    <%= internals.funs.trancateStr(internals.data[g].email, 25) %><br>
                                    <b>(<%= internals.data[g].company %>)</b>
                                </td>
                                <td><%= internals.data[g].subject %></td>
                                <td>
                                    <% if(internals.data[g].published=='0') { %>
                                    <span class="badge shade-red min-50">Not Visible</span>
                                    <% } else { %>
                                    <span class="badge shade-green min-50">Visible</span>
                                    <% } %> 
                                </td>
                                <td><%= internals.funs.trancateStr(internals.data[g].message, 60) %></td>
                                <td class="text-center">
                                    <%= internals.data[g].created_at.toLocaleDateString() %>
                                </td>
                                <td class="text-center">
                                    <% if(internals.data[g].published==1) { %> 
                                    <a href="/messages/mark0/<%= internals.data[g].fb_id %>" class="btn btn-danger" onclick="return confirm('Do you want to hide item from home page?')" title="Hide">
                                        <i class="bi bi-x-square"></i>
                                    </a>
                                    <% } else { %>
                                    <a href="/messages/mark1/<%= internals.data[g].fb_id %>" class="btn btn-success" onclick="return confirm('Do you want to show item from home page?')" title="Show">
                                        <i class="bi bi-check2-all"></i>
                                    </a>
                                    <% } %>
                                </td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                    <% } else { %>
                    <div class="alert alert-primary alert-dismissible fade show" role="alert">
                        <i class="bi bi-bullseye alert-icon"></i>No data found!
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

    </div>
</div>
<!-- Row end -->