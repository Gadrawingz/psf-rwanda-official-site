<!-- Row start -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="card-title"><h3><%- internals.title %></h3></div>
            </div>

            <% if(messages.flashError) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle alert-icon"></i>
                    <%- internals.message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

            <div class="card-body">
                <div class="custom-btn-group mb-2">
                    <a href="/panel/register" class="btn btn-info"><i class="bi bi-plus-square"></i> Add new</a>
                </div>

                <div class="table-responsive">
                    <% if(internals.data.length) { %>
                    <table class="table table-bordered m-0">
                        <thead>
                            <tr>
                                <th>N<sup>o</sup></th>
                                <th>Full Name</th>
                                <th>Username</th>
                                <th>Status</th>
                                <th>Phone</th>
                                <th>Email / Position</th>
                                <th>Role</th>
                                <th colspan="2" class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% for( let g = 0; g < internals.data.length; g++ ) { %>
                            <tr>
                                <td>
                                    <i class="bi bi-check2-circle"></i><%= (g+1) %> 
                                </td>
                                <td>
                                    <%= internals.data[g].firstname %> <%= internals.data[g].lastname %>
                                    <br><strong>(<%= internals.data[g].gender %>)</strong>
                                </td>
                                <td><%= internals.data[g].username %></td>
                                <td>
                                <% if(internals.data[g].status=='Active') { %>
                                    <span class="text-green td-status"><i class="bi bi-check-circle"></i> Active</span>
                                <% } else { %>
                                    <span class="text-red td-status"><i class="bi bi-x-circle"></i> Inactive</span>
                                <% } %>
                                </td>
                                <td><%= internals.data[g].telephone %></td>
                                <td>
                                    <strong><%= internals.data[g].email %></strong><br>
                                    <p>(<%= internals.data[g].position %>)</p>
                                </td>
                                <td class="text-green">
                                    <strong><%= internals.data[g].role %></strong></td>
                                <td class="text-center">
                                    <a href="/panel/edit/<%= internals.data[g].user_id %>" class="btn btn-primary" title="Edit record">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <%# Activate / Deactivate --%>
                                    <% if(internals.data[g].status=='Inactive') { %> 
                                    <a href="/panel/activate/<%= internals.data[g].user_id %>" class="btn btn-success" onclick="return confirm('Do you want to activate this user?')" title="Activate">
                                        <i class="bi bi-power"></i>
                                    </a>
                                    <% } else { %>
                                    <a href="/panel/deactivate/<%= internals.data[g].user_id %>" class="btn btn-danger" onclick="return confirm('Do you want to de-activate this user?')" title="De-activate">
                                        <i class="bi bi-power"></i>
                                    </a>
                                    <% } %>
                                    
                                </td>
                                <td class="text-center">
                                    <a href="/panel/add-more/<%= internals.data[g].user_id %>" class="btn btn-primary" title="Add more info+">
                                        <i class="bi bi-plus"></i>
                                    </a>
                                </td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                    <% } else { %>
                    <div class="alert alert-primary alert-dismissible fade show" role="alert">
                        <i class="bi bi-bullseye alert-icon"></i>No data found!
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

    </div>
</div>
<!-- Row end -->