<div class="content-wrapper">
    <!-- Row start -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <h3><%- internals.title %></h3>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Row start -->
                    <form action="/panel/change-password" method="post">
                        <div class="row">
                            <div class="col-xxl-8 col-xl-7 col-lg-7 col-md-6 col-sm-12 col-12">
                                <% if(message.length!=0) { %>
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="bi bi-x-circle alert-icon"></i>
                                    <%- message %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                                <% } %>
                                
                                <div class="row">
                                    <div class="col-xxl-6 col-sm-6 col-12">
                                        <div class="mb-3">
                                            <label for="old_pass" class="form-label">Old Password</label>
                                            <input type="hidden" name="admin_id" value="<%= internals.admin_id %>">
                                            <input type="password" class="form-control" id="old_pass" name="old_pass" placeholder="Old password">
                                        </div>
                                    </div>
                                    <div class="col-xxl-6 col-sm-6 col-12">
                                        <div class="mb-3">
                                            <label for="new_pass" class="form-label">New Password</label>
                                            <input type="password" class="form-control" id="new_pass" name="new_pass" placeholder="New password">
                                        </div>
                                    </div>

                                    <div class="col-xxl-12 col-sm-12 col-12">
                                        <div class="mb-3">
                                            <hr>
                                            <button class="btn btn-info" type="submit">Save Info</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <!-- Row end -->
                </div>
            </div>
            <!-- Card end -->
        </div>
    </div>
    <!-- Row end -->

</div>