<div class="content-wrapper">
    <!-- Row start -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <h3><%- internals.title %></h3>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Row start -->
                    <form action="/panel/update-self/<%= internals.admin_id %>" method="post">
                        <div class="row">
                            <div class="col-xxl-8 col-xl-7 col-lg-7 col-md-6 col-sm-12 col-12">
                                <% if(message.length!=0) { %>
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="bi bi-x-circle alert-icon"></i>
                                    <%- message %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                                <% } %>
                                
                                <div class="row">
                                    <div class="col-xxl-6 col-sm-6 col-12">
                                        <div class="mb-3">
                                            <label for="firstname" class="form-label">First Name</label>
                                            <input type="text" class="form-control" id="firstname" name="firstname" value="<%= internals.firstname %>">
                                        </div>
                                    </div>
                                    <div class="col-xxl-6 col-sm-6 col-12">
                                        <div class="mb-3">
                                            <label for="lastname" class="form-label">Last Name</label>
                                            <input type="text" class="form-control" id="lastname" name="lastname" value="<%= internals.lastname %>">
                                        </div>
                                    </div>
                                    <div class="col-xxl-6 col-sm-6 col-12">
                                        <div class="mb-3">
                                            <label for="gender" class="form-label">Gender</label>
                                            <select class="form-control" id="gender" name="gender">
                                                <option value="<%= internals.gender %>"><%= internals.gender %></option>
                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-xxl-6 col-sm-6 col-12">
                                        <div class="mb-3">
                                            <label for="phone" class="form-label">Phone Number</label>
                                            <input type="number" class="form-control" id="phone" name="telephone" value="<%= internals.telephone %>">
                                        </div>
                                    </div>

                                    <div class="col-xxl-6 col-sm-6 col-12">
                                        <div class="mb-3">
                                            <label for="username" class="form-label">Username</label>
                                            <input type="text" class="form-control" id="username" name="username" value="<%= internals.username %>">
                                        </div>
                                    </div>

                                    <div class="col-xxl-6 col-sm-6 col-12">
                                        <div class="mb-3">
                                            <label for="email" class="form-label text-red">Email Address (Uneditable)</label>
                                            <input type="text" class="form-control" id="email" name="email" value="<%= internals.email %>" readonly>
                                        </div>
                                    </div>

                                    <div class="col-xxl-12 col-sm-12 col-12">
                                        <hr>
                                        <div class="mb-3">
                                            <button class="btn btn-info" type="submit" disabled>Update Info</button>&nbsp;
                                            <a href="/panel/change-password" class="btn btn-secondary">Change Password</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <!-- Row end -->
                </div>
            </div>
            <!-- Card end -->
        </div>
    </div>
    <!-- Row end -->

</div>