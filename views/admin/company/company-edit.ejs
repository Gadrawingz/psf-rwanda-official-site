<style>
    .error-message {
        color: #d9534f;
        font-size: 0.9em;
        margin-top: 5px;
        display: block;
    }

    .field-error {
        border-color: #d9534f !important;
        box-shadow: 0 0 0 0.2rem rgba(217, 83, 79, 0.25);
    }

    .alert {
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        border: 1px solid transparent;
        border-radius: 0.25rem;
    }

    .alert-danger {
        color: #721c24;
        background-color: #f8d7da;
        border-color: #f5c6cb;
    }

    .alert-success {
        color: #155724;
        background-color: #d4edda;
        border-color: #c3e6cb;
    }

    .alert-dismissible .btn-close {
        position: absolute;
        top: 0;
        right: 0;
        padding: 0.75rem 1.25rem;
        background: transparent;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
    }

    .section-header {
        border-bottom: 2px solid #086B2C;
        padding-bottom: 8px;
        margin-bottom: 20px;
        color: #086B2C;
        font-weight: bold;
    }

    .form-container {
        border: 2px solid #086B2C;
        border-radius: 8px;
        padding: 30px;
        background-color: #fafafa;
    }
</style>

<div class="row mb-4">
    <div class="col">
        <h1 style="font-size: 32px; font-weight: bold; color: #086B2C;">
            <i class="fas fa-edit"></i> Update Company Information
        </h1>
        <p class="text-muted fs-5">
            Editing: <strong><%= company.company_name %></strong>
        </p>
    </div>
    <div class="col-auto">
        <a href="/companies/<%= company.company_id %>" class="btn btn-info me-2">
            <i class="fas fa-eye"></i> View Details
        </a>
        <a href="/companies/all" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<!-- Flash Messages -->
<div class="flash-messages-container">
    <!-- Success Messages -->
    <% if (typeof success !== 'undefined' && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <strong>Success!</strong> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Error Messages -->
    <% if (typeof error !== 'undefined' && error.length > 0) { %>
        <% if (Array.isArray(error)) { %>
            <% error.forEach(function(errorMsg) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Error!</strong> <%= errorMsg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% }); %>
        <% } else { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Error!</strong> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
    <% } %>

    <!-- Validation Errors -->
    <% if (typeof errors !== 'undefined' && Object.keys(errors).length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <h5><i class="fas fa-ban me-2"></i>Please fix the following errors:</h5>
            <ul class="mb-0">
                <% Object.keys(errors).forEach(function(field) { %>
                    <% if (errors[field] && errors[field].length > 0) { %>
                        <% errors[field].forEach(function(errorMsg) { %>
                            <li><%= errorMsg %></li>
                        <% }); %>
                    <% } %>
                <% }); %>
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
</div>

<div class="form-container">
    <form id="companyUpdateForm" action="/company-update/<%= company.company_id %>" method="POST">
        
        <!-- COMPANY INFORMATION SECTION -->
        <h4 class="section-header">
            <i class="fas fa-building me-2"></i>Company Information
        </h4>
        
        <div class="row mb-4">
            <!-- Company Name -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="company_name" class="form-label"><strong>Company Name*</strong></label>
                    <input type="text" 
                           class="form-control <%= (typeof errors !== 'undefined' && errors.company_name) ? 'field-error' : '' %>" 
                           id="company_name" 
                           name="company_name" 
                           value="<%= (typeof oldData !== 'undefined' && oldData.company_name) ? oldData.company_name : company.company_name %>" 
                           autocomplete="off"
                           required>
                    <% if (typeof errors !== 'undefined' && errors.company_name) { %>
                        <% errors.company_name.forEach(errorMsg => { %>
                            <span class="error-message"><%= errorMsg %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- TIN / Company Code -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="company_tin" class="form-label"><strong>TIN / Company Code*</strong></label>
                    <input type="text" 
                           class="form-control <%= (typeof errors !== 'undefined' && errors.company_tin) ? 'field-error' : '' %>" 
                           id="company_tin" 
                           name="company_tin" 
                           value="<%= (typeof oldData !== 'undefined' && oldData.company_tin) ? oldData.company_tin : company.company_tin %>" 
                           autocomplete="off"
                           required>
                    <% if (typeof errors !== 'undefined' && errors.company_tin) { %>
                        <% errors.company_tin.forEach(errorMsg => { %>
                            <span class="error-message"><%= errorMsg %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Business Activity -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="business_activity" class="form-label"><strong>Business Activity*</strong></label>
                    <input type="text" 
                           class="form-control <%= (typeof errors !== 'undefined' && errors.business_activity) ? 'field-error' : '' %>" 
                           id="business_activity" 
                           name="business_activity" 
                           value="<%= (typeof oldData !== 'undefined' && oldData.business_activity) ? oldData.business_activity : company.business_activity %>" 
                           autocomplete="off"
                           required>
                    <% if (typeof errors !== 'undefined' && errors.business_activity) { %>
                        <% errors.business_activity.forEach(errorMsg => { %>
                            <span class="error-message"><%= errorMsg %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Company Phone -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="company_phone" class="form-label"><strong>Company Phone*</strong></label>
                    <input type="tel" 
                           class="form-control <%= (typeof errors !== 'undefined' && errors.company_phone) ? 'field-error' : '' %>" 
                           id="company_phone" 
                           name="company_phone" 
                           value="<%= (typeof oldData !== 'undefined' && oldData.company_phone) ? oldData.company_phone : company.company_phone %>"
                           placeholder="2507XXXXXXXX" 
                           autocomplete="off"
                           required>
                    <% if (typeof errors !== 'undefined' && errors.company_phone) { %>
                        <% errors.company_phone.forEach(errorMsg => { %>
                            <span class="error-message"><%= errorMsg %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Company Email -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="company_email" class="form-label"><strong>Company Email</strong></label>
                    <input type="email" 
                           class="form-control <%= (typeof errors !== 'undefined' && errors.company_email) ? 'field-error' : '' %>" 
                           id="company_email" 
                           name="company_email" 
                           value="<%= (typeof oldData !== 'undefined' && oldData.company_email) ? oldData.company_email : (company.company_email || '') %>"
                           placeholder="name@example.com" 
                           autocomplete="off">
                    <% if (typeof errors !== 'undefined' && errors.company_email) { %>
                        <% errors.company_email.forEach(errorMsg => { %>
                            <span class="error-message"><%= errorMsg %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Company Website -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="company_website" class="form-label"><strong>Company Website</strong></label>
                    <input type="url" 
                           class="form-control <%= (typeof errors !== 'undefined' && errors.company_website) ? 'field-error' : '' %>" 
                           id="company_website" 
                           name="company_website" 
                           value="<%= (typeof oldData !== 'undefined' && oldData.company_website) ? oldData.company_website : (company.company_website || '') %>"
                           placeholder="https://example.com" 
                           autocomplete="off">
                    <% if (typeof errors !== 'undefined' && errors.company_website) { %>
                        <% errors.company_website.forEach(errorMsg => { %>
                            <span class="error-message"><%= errorMsg %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- REPRESENTATIVE INFORMATION SECTION -->
        <h4 class="section-header">
            <i class="fas fa-user-tie me-2"></i>Representative Information
        </h4>
        
        <div class="row mb-4">
            <!-- First Name -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="firstname" class="form-label"><strong>First Name*</strong></label>
                    <input type="text" 
                           class="form-control <%= (typeof errors !== 'undefined' && errors.firstname) ? 'field-error' : '' %>" 
                           id="firstname" 
                           name="firstname" 
                           autocomplete="off"
                           value="<%= (typeof oldData !== 'undefined' && oldData.firstname) ? oldData.firstname : (company.firstname || '') %>"
                           required>
                    <% if (typeof errors !== 'undefined' && errors.firstname) { %>
                        <% errors.firstname.forEach(errorMsg => { %>
                            <span class="error-message"><%= errorMsg %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Last Name -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="lastname" class="form-label"><strong>Last Name*</strong></label>
                    <input type="text" 
                           class="form-control <%= (typeof errors !== 'undefined' && errors.lastname) ? 'field-error' : '' %>" 
                           id="lastname" 
                           name="lastname" 
                           autocomplete="off"
                           value="<%= (typeof oldData !== 'undefined' && oldData.lastname) ? oldData.lastname : (company.lastname || '') %>"
                           required>
                    <% if (typeof errors !== 'undefined' && errors.lastname) { %>
                        <% errors.lastname.forEach(errorMsg => { %>
                            <span class="error-message"><%= errorMsg %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Gender -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="gender" class="form-label"><strong>Gender*</strong></label>
                    <select class="form-select <%= (typeof errors !== 'undefined' && errors.gender) ? 'field-error' : '' %>" 
                            name="gender" 
                            id="gender" 
                            required>
                        <option value="">Select gender</option>
                        <% 
                        const currentGender = (typeof oldData !== 'undefined' && oldData.gender) ? oldData.gender : company.gender;
                        %>
                        <option value="M" <%= currentGender === 'M' ? 'selected' : '' %>>Male</option>
                        <option value="F" <%= currentGender === 'F' ? 'selected' : '' %>>Female</option>
                    </select>
                    <% if (typeof errors !== 'undefined' && errors.gender) { %>
                        <% errors.gender.forEach(errorMsg => { %>
                            <span class="error-message"><%= errorMsg %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Phone Number -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="telephone" class="form-label"><strong>Phone Number*</strong></label>
                    <input type="tel" 
                           class="form-control <%= (typeof errors !== 'undefined' && errors.telephone) ? 'field-error' : '' %>" 
                           id="telephone" 
                           name="telephone" 
                           autocomplete="off"
                           value="<%= (typeof oldData !== 'undefined' && oldData.telephone) ? oldData.telephone : (company.rep_telephone || '') %>"
                           placeholder="2507XXXXXXXX" 
                           required>
                    <% if (typeof errors !== 'undefined' && errors.telephone) { %>
                        <% errors.telephone.forEach(errorMsg => { %>
                            <span class="error-message"><%= errorMsg %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Email Address -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="rep_email" class="form-label"><strong>Email Address</strong></label>
                    <input type="email" 
                           class="form-control <%= (typeof errors !== 'undefined' && errors.rep_email) ? 'field-error' : '' %>" 
                           id="rep_email" 
                           name="rep_email" 
                           autocomplete="off"
                           value="<%= (typeof oldData !== 'undefined' && oldData.rep_email) ? oldData.rep_email : (company.rep_email || '') %>"
                           placeholder="name@example.com">
                    <% if (typeof errors !== 'undefined' && errors.rep_email) { %>
                        <% errors.rep_email.forEach(errorMsg => { %>
                            <span class="error-message"><%= errorMsg %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Birth Date -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="birthday" class="form-label"><strong>Birth Date*</strong></label>
                    <input type="date" 
                           class="form-control <%= (typeof errors !== 'undefined' && errors.birthday) ? 'field-error' : '' %>" 
                           id="birthday" 
                           name="birthday" 
                           value="<%= (typeof oldData !== 'undefined' && oldData.birthday) ? oldData.birthday : (company.birthday ? new Date(company.birthday).toISOString().split('T')[0] : '') %>"
                           required>
                    <% if (typeof errors !== 'undefined' && errors.birthday) { %>
                        <% errors.birthday.forEach(errorMsg => { %>
                            <span class="error-message"><%= errorMsg %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- SUBMIT BUTTONS -->
        <div class="text-center mt-5">
            <button type="submit" class="btn btn-success btn-lg me-3" style="min-width: 150px;">
                <i class="fas fa-save"></i> Update
            </button>
            <a href="/companies/<%= company.company_id %>" class="btn btn-secondary btn-lg" style="min-width: 150px;">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Phone number formatting
    const phoneInputs = document.querySelectorAll('input[type="tel"]');
    phoneInputs.forEach(input => {
        input.addEventListener('input', function() {
            formatPhoneNumber(this);
        });
    });

    // Form validation
    const form = document.getElementById('companyUpdateForm');
    if (form) {
        form.addEventListener('submit', function(e) {
            if (!validateForm()) {
                e.preventDefault();
                showValidationAlert();
                return false;
            }
            
            // Show loading state
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
            }
        });
    }
});

function formatPhoneNumber(input) {
    let value = input.value.replace(/\D/g, ''); // Remove non-digits
    
    // Rwanda phone number format: 250XXXXXXXXX
    if (value.startsWith('250')) {
        if (value.length > 12) {
            value = value.substring(0, 12);
        }
    } else if (value.startsWith('07') || value.startsWith('08') || value.startsWith('09')) {
        // Local format: 07XXXXXXXX -> 2507XXXXXXXX
        value = '250' + value;
    }
    
    input.value = value;
}

function validateForm() {
    let isValid = true;
    const requiredFields = document.querySelectorAll('[required]');
    
    requiredFields.forEach(field => {
        if (!field.value.trim()) {
            field.classList.add('field-error');
            isValid = false;
        } else {
            field.classList.remove('field-error');
        }
    });
    
    return isValid;
}

function showValidationAlert() {
    const alertHtml = `
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Validation Error!</strong> Please fill in all required fields marked with *.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    `;
    
    const container = document.querySelector('.flash-messages-container');
    if (container) {
        container.insertAdjacentHTML('beforeend', alertHtml);
        container.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
}
</script>