            <!-- BUSINESS REPRESENTATIVE SECTION -->
            <h4 class="mb-3" style="border-bottom: solid gray 1.5px; padding-bottom: 5px">Business Representative Info</h4>
            <div class="row mb-4">
                <!-- First Name -->
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="firstname" class="form-label"><strong>First Name*</strong></label>
                        <input type="text" 
                               class="form-control <%= (typeof errors !== 'undefined' && errors.firstname) ? 'field-error' : '' %>" 
                               id="firstname" 
                               name="firstname" autocomplete="off"
                               value="<%= (typeof oldData !== 'undefined' && oldData.firstname) ? oldData.firstname : '' %>"
                               required>
                        <% if (typeof errors !== 'undefined' && errors.firstname) { %>
                            <% errors.firstname.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Last Name -->
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="lastname" class="form-label"><strong>Last Name*</strong></label>
                        <input type="text" 
                               class="form-control <%= (typeof errors !== 'undefined' && errors.lastname) ? 'field-error' : '' %>" 
                               id="lastname" 
                               name="lastname" autocomplete="off"
                               value="<%= (typeof oldData !== 'undefined' && oldData.lastname) ? oldData.lastname : '' %>"
                               required>
                        <% if (typeof errors !== 'undefined' && errors.lastname) { %>
                            <% errors.lastname.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Birth Date -->
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="birthday" class="form-label"><strong>Birth Date*</strong></label>
                        <input type="date" 
                               class="form-control <%= (typeof errors !== 'undefined' && errors.birthday) ? 'field-error' : '' %>" 
                               id="birthday" 
                               name="birthday" 
                               value="<%= (typeof oldData !== 'undefined' && oldData.birthday) ? oldData.birthday : '' %>"
                               required>
                        <% if (typeof errors !== 'undefined' && errors.birthday) { %>
                            <% errors.birthday.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Gender -->
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="gender" class="form-label"><strong>Select Gender*</strong></label>
                        <select class="form-select <%= (typeof errors !== 'undefined' && errors.gender) ? 'field-error' : '' %>" 
                            name="gender" 
                                id="gender" 
                                required>
                            <option value="">Select gender</option>
                            <option value="M" <%= (typeof oldData !== 'undefined' && oldData.gender === 'M') ? 'selected' : '' %>>Male</option>
                            <option value="F" <%= (typeof oldData !== 'undefined' && oldData.gender === 'F') ? 'selected' : '' %>>Female</option>
                        </select>
                        <% if (typeof errors !== 'undefined' && errors.gender) { %>
                            <% errors.gender.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Phone Number -->
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="telephone" class="form-label"><strong>Phone Number*</strong></label>
                        <input type="tel" 
                               class="form-control <%= (typeof errors !== 'undefined' && errors.telephone) ? 'field-error' : '' %>" 
                               id="telephone" 
                               name="telephone" autocomplete="off"
                               value="<%= (typeof oldData !== 'undefined' && oldData.telephone) ? oldData.telephone : '' %>"
                               placeholder="2507XXXXXXXX" 
                               required>
                        <% if (typeof errors !== 'undefined' && errors.telephone) { %>
                            <% errors.telephone.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Email Address -->
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="rep_email" class="form-label"><strong>Email Address</strong></label>
                        <input type="email" 
                               class="form-control <%= (typeof errors !== 'undefined' && errors.rep_email) ? 'field-error' : '' %>" 
                               id="rep_email" 
                               name="rep_email" autocomplete="off"
                               value="<%= (typeof oldData !== 'undefined' && oldData.rep_email) ? oldData.rep_email : '' %>"
                               placeholder="name@example.com">
                        <% if (typeof errors !== 'undefined' && errors.rep_email) { %>
                            <% errors.rep_email.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Nationality -->
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="nationality" class="form-label"><strong>Nationality (Citizenship)*</strong></label>
                        <select class="form-select <%= (typeof errors !== 'undefined' && errors.nationality) ? 'field-error' : '' %>" 
                                name="nationality" 
                                id="nationality" 
                                required>
                            <option value="">-- Select Nationality --</option>
                            <option value="Rwandan" <%= (typeof oldData !== 'undefined' && oldData.nationality === 'Rwandan') ? 'selected' : '' %>>Rwandan</option>
                            <option value="Non-Rwandan" <%= (typeof oldData !== 'undefined' && oldData.nationality === 'Non-Rwandan') ? 'selected' : '' %>>Non-Rwandan</option>
                        </select>
                        <% if (typeof errors !== 'undefined' && errors.nationality) { %>
                            <% errors.nationality.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- National ID (Hidden by default) -->
                <div class="col-md-4 nid-hidden" id="nationalIdGroup">
                    <div class="mb-3">
                        <label for="national_id" class="form-label"><strong>National ID*</strong></label>
                        <input type="text" 
                               class="form-control <%= (typeof errors !== 'undefined' && errors.national_id) ? 'field-error' : '' %>" 
                               id="national_id" 
                               name="national_id" 
                               value="<%= (typeof oldData !== 'undefined' && oldData.national_id) ? oldData.national_id : '' %>"
                               maxlength="16" 
                               pattern="[0-9]{16}" 
                               title="National ID must be 16 digits (numbers only)">
                        <% if (typeof errors !== 'undefined' && errors.national_id) { %>
                            <% errors.national_id.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                        <div class="error-message" id="nationalIdError"></div>
                    </div>
                </div>

                <!-- Passport Number (Hidden by default) -->
                <div class="col-md-4 nid-hidden" id="passportGroup">
                    <div class="mb-3">
                        <label for="passport_number" class="form-label"><strong>Passport Number*</strong></label>
                        <input type="text" 
                               class="form-control <%= (typeof errors !== 'undefined' && errors.passport_number) ? 'field-error' : '' %>" 
                               id="passport_number" 
                               name="passport_number" 
                               value="<%= (typeof oldData !== 'undefined' && oldData.passport_number) ? oldData.passport_number : '' %>"
                               minlength="6" 
                               maxlength="12" 
                               pattern="[A-Z0-9]{6,12}" 
                               title="Passport must be 6-12 characters (uppercase letters and numbers)">
                        <% if (typeof errors !== 'undefined' && errors.passport_number) { %>
                            <% errors.passport_number.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                        <div class="error-message" id="passportError"></div>
                    </div>
                </div>

                <!-- Health Insurance -->
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="has_insurance" class="form-label"><strong>Health Coverage (Insurance) Status*</strong></label>
                        <select class="form-select <%= (typeof errors !== 'undefined' && errors.has_insurance) ? 'field-error' : '' %>" 
                                name="has_insurance" 
                                id="has_insurance" 
                                required>
                            <option value="">-- Select option --</option>
                            <option value="1" <%= (typeof oldData !== 'undefined' && oldData.has_insurance === '1') ? 'selected' : '' %>>Yes, Insured</option>
                            <option value="0" <%= (typeof oldData !== 'undefined' && oldData.has_insurance === '0') ? 'selected' : '' %>>No, Uninsured</option>
                        </select>
                        <% if (typeof errors !== 'undefined' && errors.has_insurance) { %>
                            <% errors.has_insurance.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Preferred Language -->
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="preferred_language" class="form-label"><strong>Preferred Language*</strong></label>
                        <select class="form-select <%= (typeof errors !== 'undefined' && errors.preferred_language) ? 'field-error' : '' %>" 
                                name="preferred_language" 
                                id="preferred_language" 
                                required>
                            <option value="">-- Select Language --</option>
                            <option value="kinyarwanda" <%= (typeof oldData !== 'undefined' && oldData.preferred_language === 'kinyarwanda') ? 'selected' : '' %>>Kinyarwanda</option>
                            <option value="kiswahili" <%= (typeof oldData !== 'undefined' && oldData.preferred_language === 'kiswahili') ? 'selected' : '' %>>Kiswahili (Swahili)</option>
                            <option value="english" <%= (typeof oldData !== 'undefined' && oldData.preferred_language === 'english') ? 'selected' : '' %>>English</option>
                            <option value="french" <%= (typeof oldData !== 'undefined' && oldData.preferred_language === 'french') ? 'selected' : '' %>>French</option>
                            <option value="other" <%= (typeof oldData !== 'undefined' && oldData.preferred_language === 'other') ? 'selected' : '' %>>Other</option>
                        </select>
                        <% if (typeof errors !== 'undefined' && errors.preferred_language) { %>
                            <% errors.preferred_language.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Areas of Interest -->
                <div class="col-md-4">
                    <div class="mb-3">
                        <label for="areas_of_interest" class="form-label"><strong>Main Areas of Interest*</strong></label>
                        <select class="form-select <%= (typeof errors !== 'undefined' && errors.areas_of_interest) ? 'field-error' : '' %>" 
                                name="areas_of_interest" 
                                id="areas_of_interest" 
                                required>
                            <option value="">-- Select Area of Interest --</option>
                            <optgroup label="PSF Services">
                                <option value="exhibitions" <%= (typeof oldData !== 'undefined' && oldData.areas_of_interest === 'exhibitions') ? 'selected' : '' %>>Exhibitions</option>
                                <option value="recommendations" <%= (typeof oldData !== 'undefined' && oldData.areas_of_interest === 'recommendations') ? 'selected' : '' %>>Recommendations (Quitus/REMA)</option>
                                <option value="advocacy" <%= (typeof oldData !== 'undefined' && oldData.areas_of_interest === 'advocacy') ? 'selected' : '' %>>Proactive Advocacy</option>
                                <option value="business_research" <%= (typeof oldData !== 'undefined' && oldData.areas_of_interest === 'business_research') ? 'selected' : '' %>>Business Research</option>
                                <option value="capacity_building" <%= (typeof oldData !== 'undefined' && oldData.areas_of_interest === 'capacity_building') ? 'selected' : '' %>>Trainings & Capacity Building</option>
                                <option value="trade_missions" <%= (typeof oldData !== 'undefined' && oldData.areas_of_interest === 'trade_missions') ? 'selected' : '' %>>Trade Missions</option>
                                <option value="access_to_market" <%= (typeof oldData !== 'undefined' && oldData.areas_of_interest === 'access_to_market') ? 'selected' : '' %>>Access to Market & Linkages</option>
                                <option value="business_clinic" <%= (typeof oldData !== 'undefined' && oldData.areas_of_interest === 'business_clinic') ? 'selected' : '' %>>Business Clinic and Advisory</option>
                                <option value="medical_scheme" <%= (typeof oldData !== 'undefined' && oldData.areas_of_interest === 'medical_scheme') ? 'selected' : '' %>>Access to Medical Scheme</option>
                                <option value="networking" <%= (typeof oldData !== 'undefined' && oldData.areas_of_interest === 'networking') ? 'selected' : '' %>>Networking(B2B, B2C & B2G)</option>
                            </optgroup>
                            <optgroup label="Other interests">
                                <option value="Others" <%= (typeof oldData !== 'undefined' && oldData.areas_of_interest === 'Others') ? 'selected' : '' %>>Others</option>
                            </optgroup>
                        </select>
                        <% if (typeof errors !== 'undefined' && errors.areas_of_interest) { %>
                            <% errors.areas_of_interest.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- ADDITIONAL INFO SECTION -->
            <h4 class="mb-3" style="border-bottom: solid gray 1.5px; padding-bottom: 5px">Additional Info</h4>
            <div class="row mb-4">
                <!-- Registration Type -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="registration_type" class="form-label"><strong>Registration Type*</strong></label>
                        <select class="form-select <%= (typeof errors !== 'undefined' && errors.registration_type) ? 'field-error' : '' %>" 
                                name="registration_type" 
                                id="registration_type" 
                                required>
                            <option value="TIN" <%= (typeof oldData !== 'undefined' && oldData.registration_type === 'TIN') ? 'selected' : (!oldData ? 'selected' : '') %>>TIN (Default)</option>
                            <option value="Patent" <%= (typeof oldData !== 'undefined' && oldData.registration_type === 'Patent') ? 'selected' : '' %>>Patent</option>
                            <option value="RCA Number" <%= (typeof oldData !== 'undefined' && oldData.registration_type === 'RCA Number') ? 'selected' : '' %>>RCA Number</option>
                            <option value="Other" <%= (typeof oldData !== 'undefined' && oldData.registration_type === 'Other') ? 'selected' : '' %>>Other</option>
                        </select>
                        <% if (typeof errors !== 'undefined' && errors.registration_type) { %>
                            <% errors.registration_type.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Registration Number -->
                <div class="col-md-6" id="registration_number_container">
                    <div class="mb-3">
                        <label for="registration_number" class="form-label" id="registration_number_label">
                            <strong>TIN Number*</strong>
                        </label>
                        <input type="text" 
                               class="form-control auto-filled <%= (typeof errors !== 'undefined' && errors.registration_number) ? 'field-error' : '' %>" 
                               id="registration_number" 
                               name="registration_number" 
                               value="<%= (typeof oldData !== 'undefined' && oldData.registration_number) ? oldData.registration_number : '' %>"
                               readonly>
                        <div class="form-text" id="registration_help_text">Auto-filled from TIN field above</div>
                        <% if (typeof errors !== 'undefined' && errors.registration_number) { %>
                            <% errors.registration_number.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Business Scope -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="business_scope" class="form-label"><strong>Select Business Scope*</strong></label>
                        <select class="form-select <%= (typeof errors !== 'undefined' && errors.business_scope) ? 'field-error' : '' %>" 
                                name="business_scope" 
                                id="business_scope" 
                                required>
                            <option value="international" <%= (typeof oldData !== 'undefined' && oldData.business_scope === 'international') ? 'selected' : (!oldData ? 'selected' : '') %>>International</option>
                            <option value="local" <%= (typeof oldData !== 'undefined' && oldData.business_scope === 'local') ? 'selected' : 'selected' %>>Local</option>
                        </select>
                        <% if (typeof errors !== 'undefined' && errors.business_scope) { %>
                            <% errors.business_scope.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Local Places (Hidden by default) -->
                <div class="col-md-6 hidden-field" id="local_places_field">
                    <div class="mb-3">
                        <label for="local_places" class="form-label"><strong>Local Places (optional)</strong></label>
                        <input type="text" 
                               class="form-control" 
                               id="local_places" 
                               name="local_places" autocomplete="off"
                               value="<%= (typeof oldData !== 'undefined' && oldData.local_places) ? oldData.local_places : '' %>"
                               placeholder="Nyanza, Kayonza, Burera,...">
                        <span class="error-message" id="local_places_error"></span>
                    </div>
                </div>

                <!-- International Countries (Hidden by default) -->
                <div class="col-md-6 hidden-field" id="int_countries_field">
                    <div class="mb-3">
                        <label for="int_countries" class="form-label"><strong>International Countries*</strong></label>
                        <input type="text" 
                               class="form-control <%= (typeof errors !== 'undefined' && errors.int_countries) ? 'field-error' : '' %>" 
                               id="int_countries" 
                               name="int_countries" 
                               value="<%= (typeof oldData !== 'undefined' && oldData.int_countries) ? oldData.int_countries : '' %>"
                               placeholder="Uganda, Ghana,.." 
                               required>
                        <% if (typeof errors !== 'undefined' && errors.int_countries) { %>
                            <% errors.int_countries.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Membership Status -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label"><strong>Membership Status*</strong></label>
                        <div class="col-12">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="membership_status" id="member_new" value="New"
                                       <%= (typeof oldData !== 'undefined' && oldData.membership_status === 'New') ? 'checked' : (!oldData ? 'checked' : 'checked') %>>
                                <label class="form-check-label" for="member_new">Not a Member</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="membership_status" id="member_exist" value="Exist"
                                       <%= (typeof oldData !== 'undefined' && oldData.membership_status === 'Exist') ? 'checked' : '' %>>
                                <label class="form-check-label" for="member_exist">A Member</label>
                            </div>
                        </div>
                        <% if (typeof errors !== 'undefined' && errors.membership_status) { %>
                            <% errors.membership_status.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Membership Category -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="membership_category" class="form-label"><strong>Membership Category*</strong></label>
                        <select class="form-select <%= (typeof errors !== 'undefined' && errors.membership_category) ? 'field-error' : '' %>" 
                                name="membership_category" 
                                id="membership_category" 
                                required>
                            <option value="">-- Select Category --</option>
                            <!-- Options will be dynamically populated by JavaScript -->
                        </select>
                        <% if (typeof errors !== 'undefined' && errors.membership_category) { %>
                            <% errors.membership_category.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Association Relationship -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label"><strong>Relationship with Associations*</strong></label>
                        <div class="col-12">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="has_association" id="has_ass_no" value="0"
                                    <%= (typeof oldData !== 'undefined' && oldData.has_association === '0') ? 'checked' : (!oldData || !oldData.has_association ? 'checked' : '') %>>
                                <label class="form-check-label" for="has_ass_no">Not a Partner</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="has_association" id="has_ass_yes" value="1"
                                    <%= (typeof oldData !== 'undefined' && oldData.has_association === '1') ? 'checked' : '' %>>
                                <label class="form-check-label" for="has_ass_yes">Partner to associations</label>
                            </div>
                        </div>
                        <% if (typeof errors !== 'undefined' && errors.has_association) { %>
                            <% errors.has_association.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- Association Selection (Initially Hidden) -->
                <div class="col-md-6" id="association_select_container" style="display: none;">
                    <div class="mb-3">
                        <label for="association_id" class="form-label"><strong>Select Association*</strong></label>
                        <select class="form-select <%= (typeof errors !== 'undefined' && errors.association_id) ? 'field-error' : '' %>" 
                                name="association_id" 
                                id="association_id">
                            <option value="">-- Select association --</option>
                        </select>
                        <div class="spinner-border spinner-border-sm text-primary mt-2" role="status" id="association_loader" style="display: none;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <% if (typeof errors !== 'undefined' && errors.association_id) { %>
                            <% errors.association_id.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

                <!-- PSF Association Contributor (Initially Hidden) -->
                <div class="col-md-6" id="psf_contributor_container" style="display: none;">
                    <div class="mb-3">
                        <label class="form-label"><strong>Contributor to PSF Association*</strong></label>
                        <div class="col-12">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="assoc_contributor" id="contributor_no" value="0"
                                    <%= (typeof oldData !== 'undefined' && oldData.assoc_contributor === '0') ? 'checked' : (!oldData || !oldData.assoc_contributor ? 'checked' : '') %>>
                                <label class="form-check-label" for="contributor_no">No, I am not</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="assoc_contributor" id="contributor_yes" value="1"
                                    <%= (typeof oldData !== 'undefined' && oldData.assoc_contributor === '1') ? 'checked' : '' %>>
                                <label class="form-check-label" for="contributor_yes">Yes I am</label>
                            </div>
                        </div>
                        <% if (typeof errors !== 'undefined' && errors.assoc_contributor) { %>
                            <% errors.assoc_contributor.forEach(errorMsg => { %>
                                <span class="error-message"><%= errorMsg %></span>
                            <% }) %>
                        <% } %>
                    </div>
                </div>

            </div>

            <!-- SUBMIT BUTTON -->
            <div class="text-center">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-save"></i> Register
                </button>
                <a href="/companies/all" class="btn btn-secondary btn-lg ms-2">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<script src="../admin/js/membership.js"></script>