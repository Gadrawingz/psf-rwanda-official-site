<!-- Row start -->
<div class="row">
  <div class="col-xxl-3 col-sm-6 col-12">
    <div class="stats-tile">
      <div class="sale-icon shade-green">
        <i class="bi bi-handbag"></i>
      </div>
      <div class="sale-details">
        <h3 class="text-green"><%- internals.allUsersNumber[0][0].users_count %></h3>
        <p>Registered Users</p>
      </div>
    </div>
  </div>

  <div class="col-xxl-3 col-sm-6 col-12">
    <div class="stats-tile">
      <div class="sale-icon shade-red">
        <i class="bi bi-pie-chart"></i>
      </div>
      <div class="sale-details">
        <h3 class="text-red"><%- internals.postsNumber[0][0].posts_count %></h3>
        <p>Press Releases</p>
      </div>
    </div>
  </div>

  <div class="col-xxl-3 col-sm-6 col-12">
    <div class="stats-tile">
      <div class="sale-icon shade-blue">
        <i class="bi bi-emoji-smile"></i>
      </div>
      <div class="sale-details">
        <h3 class="text-blue"><%- internals.publicationsNum[0][0].pubs_count %></h3>
        </h3>
        <p>Publications</p>
      </div>
    </div>
  </div>

  <div class="col-xxl-3 col-sm-6 col-12">
    <div class="stats-tile">
      <div class="sale-icon shade-yellow">
        <i class="bi bi-box-seam"></i>
      </div>
      <div class="sale-details">
        <h3 class="text-yellow"><%- internals.eventsNumber[0][0].events_count %></h3>
        <p>Upcoming Events</p>
      </div>
    </div>
  </div>
</div>
<!-- Row end -->


<!-- Row start -->
<div class="row">
  <div class="col-xxl-12 col-sm-12 col-12">
    <div class="card">
      <div class="card-body">
        <!-- Row start -->
        <div class="row">
          <div class="col-xxl-3 col-sm-4 col-12">
            <div class="reports-summary">
              <div class="reports-summary-block">
                <i class="bi bi-circle-fill text-primary me-2"></i>
                <div class="d-flex flex-column">
                  <h6>Kigali City</h6>
                  <h5><%- internals.kigaliCounts[0][0].count_kigali %> members</h5>
                </div>
              </div>
              <div class="reports-summary-block">
                <i class="bi bi-circle-fill text-success me-2"></i>
                <div class="d-flex flex-column">
                  <h6>Eastern Province</h6>
                  <h5><%- internals.eastCounts[0][0].count_east %> members</h5>
                </div>
              </div>
              <div class="reports-summary-block">
                <i class="bi bi-circle-fill text-danger me-2"></i>
                <div class="d-flex flex-column">
                  <h6>Western Province</h6>
                  <h5><%- internals.westCounts[0][0].count_west %> members</h5>
                </div>
              </div>
              <div class="reports-summary-block">
                <i class="bi bi-circle-fill text-warning me-2"></i>
                <div class="d-flex flex-column">
                  <h6>Southern Province</h6>
                  <h5><%- internals.southCounts[0][0].count_south %> members</h5>
                </div>
              </div>
              <div class="reports-summary-block">
                <i class="bi bi-circle-fill text-warning me-2"></i>
                <div class="d-flex flex-column">
                  <h6>North Province</h6>
                  <h5><%- internals.northCounts[0][0].count_north %> members</h5>
                </div>
              </div>
            </div>
          </div>
          <div class="col-xxl-9 col-sm-8 col-12">
            <div class="row">
              <div class="col-12">
                <div class="graph-day-selection mt-2" role="group">
                  <button type="button" class="btn active">Today</button>
                  <button type="button" class="btn">Yesterday</button>
                  <button type="button" class="btn">7 days</button>
                  <button type="button" class="btn">15 days</button>
                  <button type="button" class="btn">30 days</button>
                </div>
              </div>
              <div class="col-12">
                <div id="stackedBarChart"></div>
              </div>
            </div>
          </div>
        </div>
        <!-- Row end -->
      </div>
    </div>
  </div>
</div>
<!-- Row end -->