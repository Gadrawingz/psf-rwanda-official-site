<!-- Row start -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="card-title"><h3><%- internals.title %></h3></div>
            </div>
            <div class="card-body">
                <div class="custom-btn-group">
                    <a href="/media/publish" class="btn btn-info"><i class="bi bi-plus-square"></i> Add new</a>
                </div>
            </div>


            <div class="card-body">
                <div class="table-responsive">
                    
                    <table class="table table-bordered m-0">
                        <thead>
                            <tr>
                                <th>N<sup>o</sup></th>
                                <th>Document Title</th>
                                <th>Description</th>
                                <th>Document</th>
                                <th colspan="2" class="text-center">Action</th>
                            </tr>
                        </thead>


                    </table>
                    
                    <div class="alert alert-primary alert-dismissible fade show" role="alert">
                        <i class="bi bi-bullseye alert-icon"></i>No data found!
                    </div>
                    
                </div>
            </div>
        </div>

    </div>
</div>
<!-- Row end -->