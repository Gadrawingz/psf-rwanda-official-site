<div class="content-wrapper">
    <div class="row">
        <div class="col-xl-12">
            <!-- Card start -->
            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <h3><%- internals.title %></h3>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Row start -->
                    <form action="/panel" method="post">
                        <div class="row">
                            <div class="col-xxl-8 col-xl-7 col-lg-7 col-md-6 col-sm-12 col-12">
                                <div class="row">
                                    <div class="col-xxl-6 col-sm-6 col-12">
                                        <div class="mb-3">
                                            <label for="firstname" class="form-label">First Name</label>
                                            <input type="text" class="form-control" id="firstname" name="firstname">
                                        </div>
                                    </div>
                                    <div class="col-xxl-6 col-sm-6 col-12">
                                        <div class="mb-3">
                                            <label for="lastname" class="form-label">Last Name</label>
                                            <input type="text" class="form-control" id="lastname" name="lastname">
                                        </div>
                                    </div>

                                    <div class="col-xxl-6 col-sm-12 col-12">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="input-group">
                                                    <input type="file" class="form-control" id="inputGroupFile02">
                                                    <label class="input-group-text"
                                                        for="inputGroupFile02">Upload</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xxl-6 col-sm-12 col-12">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="input-group">
                                                    <button class="btn btn-light" type="button"
                                                        id="inputGroupFileAddon03">Button</button>
                                                    <input type="file" class="form-control" id="inputGroupFile03"
                                                        aria-describedby="inputGroupFileAddon03" aria-label="Upload">
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                                <div class="col-sm-12 col-12">
                                    <hr>
                                    <button class="btn btn-info" type="submit">Save Info</button>
                                    <button class="btn btn-danger" type="reset">Reset</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <!-- Card end -->
        </div>
    </div>
    <!-- Row end -->

</div>