<!-- Row start -->
<div class="row">
    <div class="col-sm-12 col-12">
        <div class="card">
            <div class="card-header">
                <div class="card-title"><%- internals.title %> </div>
            </div>
            <div class="card-body">

                <!-- Row start -->
                <div class="row">
                    <div class="col-xxl-8 col-sm-8 col-12">
                        <!-- Row start -->
                        <div class="row">
                            <div class="col-sm-12 col-12">
                                <!-- Card start -->
                                <div class="card">
                                    <div class="card-body">
                                        <form action="" method="post">
                                            <div class="mb-2">
                                                <div class="summernote"></div>
                                            </div>
                                            <div class="custom-btn-group flex-end">
                                                <button class="btn btn-dark" type="reset">Clear</button>
                                                <button class="btn btn-info" type="submit">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                                <!-- Card end -->
                            </div>
                        </div>
                        <!-- Row end -->
                    </div>
                    <div class="col-sm-4 col-12">

                        <!-- Products List -->
                        <div class="product-list-card">
                            <h5>All Posts</h5>
                            <div class="product-list-block">
                                <img class="product-list-img" src="../admin/images/food/img7.jpg" alt="Admin Panel">
                                <div class="product-list-details">
                                    <h5 class="product-list-title">My first press release</h5>
                                    <div class="product-list-price">Edit</div>
                                </div>
                            </div>
                            <div class="product-list-block">
                                <img class="product-list-img" src="../admin/images/food/img9.jpg" alt="Admin Panel">
                                <div class="product-list-details">
                                    <h5 class="product-list-title">Harvest Cobb In Expo</h5>
                                    <div class="product-list-price">Edit</div>
                                </div>
                            </div>
                            <div class="product-list-block">
                                <img class="product-list-img" src="../admin/images/food/img2.jpg" alt="Admin Panel">
                                <div class="product-list-details">
                                    <h5 class="product-list-title">Third posts (Post release)</h5>
                                    <div class="product-list-price">Edit</div>
                                </div>
                            </div>
                            <div class="product-list-block">
                                <img class="product-list-img" src="../admin/images/food/img6.jpg" alt="Admin Panel">
                                <div class="product-list-details">
                                    <h5 class="product-list-title">Garden Chickpea Salad</h5>
                                    <div class="product-list-price">Edit</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <!-- Row end -->

            </div>
        </div>
    </div>
</div>
<!-- Row end -->